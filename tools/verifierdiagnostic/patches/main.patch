+type linuxVerifierStorageEvent struct {
+	kind                 journalFrameKind
+	operation            string
+	start, end           time.Duration
+	complete             bool
+	usageStart, usageEnd linuxVerifierProcessUsage
+}
+
+// Process totals can bound CPU use during a span; concurrent goroutines also
+// contribute. They do not identify disk wait or host/hypervisor scheduling.
+type linuxVerifierProcessUsage struct {
+	cpuNS, voluntarySwitches, involuntarySwitches, minorFaults, majorFaults int64
+	ok                                                                      bool
+}
+
+func linuxVerifierUsage() linuxVerifierProcessUsage {
+	var u syscall.Rusage
+	if syscall.Getrusage(syscall.RUSAGE_SELF, &u) != nil {
+		return linuxVerifierProcessUsage{}
+	}
+	return linuxVerifierProcessUsage{cpuNS: (u.Utime.Sec+u.Stime.Sec)*1e9 + (int64(u.Utime.Usec)+int64(u.Stime.Usec))*1000, voluntarySwitches: int64(u.Nvcsw), involuntarySwitches: int64(u.Nivcsw), minorFaults: int64(u.Minflt), majorFaults: int64(u.Majflt), ok: true}
+}
+
+func (s *linuxVerifierTrace) beginStorage(kind journalFrameKind, operation string) func() {
+	i := len(s.storage)
+	s.storage = append(s.storage, linuxVerifierStorageEvent{kind: kind, operation: operation, start: time.Since(s.start)})
+	ctx := s.diagnosticContext
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	region := runtimetrace.StartRegion(ctx, fmt.Sprintf("journal/%d/%s", kind, operation))
+	s.storage[i].usageStart = linuxVerifierUsage()
+	return func() {
+		s.storage[i].usageEnd = linuxVerifierUsage()
+		region.End()
+		s.storage[i].end, s.storage[i].complete = time.Since(s.start), true
+	}
 }
 
