new file mode 100644
--- /dev/null
+++ b/internal/grants/zz_verifier_storage_diagnostic_test.go
@@ -0,0 +1,121 @@
+package grants
+
+import (
+	"context"
+	"errors"
+	"os"
+	"testing"
+	"time"
+)
+
+// These controls exercise the observer without changing the gate's attempts.
+// No performance verdict is inferred from the synthetic delay.
+func TestLinuxStorageDiagnosticControls(t *testing.T) {
+	for _, mode := range []string{"absent", "real-sync", "delayed-sync", "sync-error", "write-error"} {
+		t.Run(mode, func(t *testing.T) {
+			g := newLinuxCombinedRig(t)
+			trace := &linuxVerifierTrace{start: time.Now(), storage: make([]linuxVerifierStorageEvent, 0, 8)}
+			ctx := context.Background()
+			if mode != "absent" {
+				ctx = context.WithValue(ctx, linuxAdmissionObserverKey{}, trace)
+			}
+			s, err := openMUState(ctx, g.config.State, g.config.Binding)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() {
+				if s != nil {
+					s.close()
+				}
+			}()
+			writes, syncs := 0, 0
+			var entered, returned time.Duration
+			s.write = func(f *os.File, b []byte) (int, error) {
+				writes++
+				if mode == "write-error" {
+					return 0, os.ErrPermission
+				}
+				return f.Write(b)
+			}
+			s.sync = func(f *os.File) error {
+				syncs++
+				entered = time.Since(trace.start)
+				defer func() { returned = time.Since(trace.start) }()
+				if mode == "sync-error" {
+					return os.ErrPermission
+				}
+				if mode == "delayed-sync" {
+					time.Sleep(5 * time.Millisecond)
+				}
+				return f.Sync()
+			}
+			err = s.markSnapshots(map[string]time.Time{g.dock.config.PublisherKey: g.dock.now})
+			bad := mode == "sync-error" || mode == "write-error"
+			if (err != nil) != bad || writes != 1 || (mode == "write-error" && syncs != 0) || (mode != "write-error" && syncs != 1) {
+				t.Fatalf("mode=%s err=%v writes=%d syncs=%d", mode, err, writes, syncs)
+			}
+			if bad && (!errors.Is(err, ErrMUState) || !s.failed || !s.highWater[g.dock.config.PublisherKey].IsZero()) {
+				t.Fatal("error semantics changed", err, s.failed, s.highWater)
+			}
+			if mode == "absent" {
+				if s.storageObserver != nil || len(trace.storage) != 0 {
+					t.Fatal("unexpected observer")
+				}
+			} else {
+				want := 2
+				if mode == "write-error" {
+					want = 1
+				}
+				if len(trace.storage) != want {
+					t.Fatal(trace.storage)
+				}
+				for _, e := range trace.storage {
+					if !e.complete || e.end < e.start || e.kind != journalSnapshotMark {
+						t.Fatal(e)
+					}
+				}
+				if syncs == 1 {
+					e := trace.storage[1]
+					if e.operation != "sync" || e.start > entered || e.end < returned || trace.storage[0].start > e.start || trace.storage[0].end < e.end {
+						t.Fatal("sync moved outside its bracket", trace.storage, entered, returned)
+					}
+				}
+			}
+			if !bad {
+				s.close()
+				s = nil
+				reopened, err := openMUState(context.Background(), g.config.State, g.config.Binding)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer reopened.close()
+				if !reopened.highWater[g.dock.config.PublisherKey].Equal(g.dock.now) {
+					t.Fatal("mark lost on reopen")
+				}
+			}
+		})
+	}
+}
+
+func TestLinuxDiagnosticIdentityControls(t *testing.T) {
+	dir := t.TempDir()
+	path := dir + "/public-diagnostic-fixture"
+	if err := os.WriteFile(path, []byte("abc"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	digest, err := linuxVerifierExecutableDigest(path)
+	if err != nil || digest != "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" {
+		t.Fatal(digest, err)
+	}
+	if _, err := linuxVerifierExecutableDigest(dir + "/absent"); err == nil {
+		t.Fatal("missing executable accepted")
+	}
+	if _, err := linuxVerifierExecutableDigest(dir); err == nil {
+		t.Fatal("unreadable executable accepted")
+	}
+	identity, err := linuxVerifierDiagnosticIdentity()
+	if err != nil || identity == "" {
+		t.Fatal(identity, err)
+	}
+	t.Log(identity)
+}
