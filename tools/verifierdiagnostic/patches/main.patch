+// Hash the actual running test executable, outside every measured interval.
+// No arguments, environment, fixture contents or journal payload are emitted.
+func linuxVerifierExecutableDigest(path string) (string, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return "", err
+	}
+	defer f.Close()
+	h := sha256.New()
+	if _, err := io.Copy(h, f); err != nil {
+		return "", err
+	}
+	return fmt.Sprintf("%x", h.Sum(nil)), nil
+}
+func linuxVerifierDiagnosticIdentity() (string, error) {
+	path, err := os.Executable()
+	if err != nil {
+		return "", err
+	}
+	digest, err := linuxVerifierExecutableDigest(path)
+	if err != nil {
+		return "", err
+	}
+	return fmt.Sprintf("platform=%s/%s go=%s executable_sha256=%s", runtime.GOOS, runtime.GOARCH, runtime.Version(), digest), nil
+}
